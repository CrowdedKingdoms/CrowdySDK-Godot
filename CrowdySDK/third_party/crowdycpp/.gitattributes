# Normalise line endings to LF in the repository and in every working tree,
# including Windows checkouts where core.autocrlf defaults to true.
#
# This is load-bearing, not cosmetic. scripts/codegen.mjs stamps the generated
# headers with a sha256 over the raw bytes of schema.gql and operations/**, so a
# CRLF working tree produces a fingerprint no other platform can reproduce and
# the deterministic codegen check fails everywhere except the machine that ran it.
* text=auto eol=lf
